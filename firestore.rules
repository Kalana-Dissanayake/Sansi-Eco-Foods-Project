rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read for products, categories, settings, coupons
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: anyone can create, only admin/staff can read all
    match /orders/{id} {
      allow create: if true;
      allow read, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    // Counters: needed for sequential order numbering
    match /counters/{id} {
      allow read: if true;
      allow write: if true; // Protected by transaction logic
    }

    // Customers: admin only
    match /customers/{id} {
      allow read, write: if isAdmin();
    }

    // Contact messages: anyone can create, admin can read/update
    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin users: super_admin only
    match /users/{id} {
      allow read, write: if isSuperAdmin();
      // Allow users to read their own document (for role check)
      allow read: if request.auth != null && request.auth.uid == id;
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'staff'];
    }

    function isSuperAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isStaff() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
  }
}
